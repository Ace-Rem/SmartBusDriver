    android:id="@+id/nav_graph"
    app:startDestination="@id/tripFragment">

    <fragment
        android:id="@+id/tripFragment"
        android:name="com.smartbus.driver.ui.TripFragment"
        android:label="@string/nav_dashboard" />

    <fragment
        android:id="@+id/googleMapFragment"
        android:name="com.smartbus.driver.ui.GoogleMapFragment"
        android:label="@string/nav_map" />

    <fragment
        android:id="@+id/routeFragment"
        android:name="com.smartbus.driver.ui.RouteFragment"
        android:label="@string/route_title" />

    <fragment
        android:id="@+id/passengerRecordFragment"
        android:name="com.smartbus.driver.ui.PassengerRecordFragment"
