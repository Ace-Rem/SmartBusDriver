<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Smartbus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#7BB4FF</item>
        <item name="colorOnPrimary">#001B3D</item>
        <item name="colorPrimaryContainer">#0B63CE</item>
        <item name="colorOnPrimaryContainer">#D8E8FF</item>
        <item name="colorSecondary">#B5C2D4</item>
        <item name="colorOnSecondary">#1B2736</item>
        <item name="colorSecondaryContainer">#3A4758</item>
        <item name="colorOnSecondaryContainer">#E4EAF2</item>
        <item name="android:colorBackground">#0F1624</item>
        <item name="colorSurface">#182233</item>
        <item name="colorOnSurface">#EAF0F8</item>
        <item name="colorSurfaceVariant">#2A3648</item>
        <item name="colorOnSurfaceVariant">#B5C2D4</item>
        <item name="colorOutline">#3F4C60</item>
        <item name="colorError">#FFB4AB</item>
        <item name="android:statusBarColor">#0F1624</item>
        <item name="android:navigationBarColor">#0F1624</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">#0F1624</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="materialButtonStyle">@style/Widget.Smartbus.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Smartbus.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.Smartbus.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.Smartbus.BottomNavigation</item>
    </style>

    <style name="Theme.Smartbus.Splash" parent="Theme.Smartbus">
        <item name="android:statusBarColor">#0F1624</item>
        <item name="android:navigationBarColor">#0F1624</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
