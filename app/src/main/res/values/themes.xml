<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Smartbus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorOnPrimary">@color/md3_on_primary</item>
        <item name="colorPrimaryContainer">@color/md3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md3_on_primary_container</item>
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md3_on_secondary_container</item>
        <item name="android:colorBackground">@color/md3_background</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md3_on_surface_variant</item>
        <item name="colorOutline">@color/md3_outline</item>
        <item name="colorError">@color/smartbus_error</item>
        <item name="android:statusBarColor">@color/md3_primary</item>
        <item name="android:navigationBarColor">@color/md3_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/md3_background</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="materialButtonStyle">@style/Widget.Smartbus.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Smartbus.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.Smartbus.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.Smartbus.BottomNavigation</item>
        <item name="snackbarStyle">@style/Widget.Material3.Snackbar</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Smartbus.Card</item>
    </style>

    <style name="Theme.Smartbus.Splash" parent="Theme.Smartbus">
        <item name="android:statusBarColor">@color/md3_primary_container</item>
        <item name="android:navigationBarColor">@color/md3_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
    </style>
</resources>
