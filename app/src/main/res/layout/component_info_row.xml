<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.Smartbus.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <ImageView
            android:id="@+id/infoIcon"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:background="@drawable/bg_soft_blue"
            android:contentDescription="@string/app_name"
            android:padding="6dp"
            android:src="@drawable/ic_route"
            app:tint="@color/md3_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infoLabel"
                style="@style/TextAppearance.Smartbus.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_label" />

            <TextView
                android:id="@+id/infoValue"
                style="@style/TextAppearance.Smartbus.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/placeholder_dash"
                tools:text="BX01 - Trung tâm" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
