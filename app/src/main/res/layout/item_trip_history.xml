<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    style="@style/Widget.Smartbus.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_soft_blue"
                android:contentDescription="@string/history_title"
                android:padding="8dp"
                android:src="@drawable/ic_history"
                app:tint="@color/md3_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tripNameTextView"
                    style="@style/TextAppearance.Smartbus.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_dash"
                    tools:text="BX01 - Chuyến sáng" />

                <TextView
                    android:id="@+id/tripTimeTextView"
                    style="@style/TextAppearance.Smartbus.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/trip_time_label"
                    tools:text="06:30 - 08:15" />
            </LinearLayout>

            <TextView
                android:id="@+id/tripStatusTextView"
                style="@style/TextAppearance.Smartbus.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_success"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="@string/history_completed"
                android:textColor="@color/smartbus_success" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tripDistanceTextView"
                style="@style/TextAppearance.Smartbus.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_soft_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="@string/history_distance"
                android:textColor="@color/md3_primary"
                tools:text="18,4 km" />

            <TextView
                android:id="@+id/tripPassengerTextView"
                style="@style/TextAppearance.Smartbus.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_soft_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="@string/history_passengers"
                android:textColor="@color/md3_primary"
                tools:text="64 khách" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
