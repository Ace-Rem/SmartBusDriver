<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/md3_surface"
            app:cardCornerRadius="@dimen/radius_xxl"
            app:cardElevation="@dimen/elevation_card_raised"
            app:strokeColor="@color/smartbus_divider"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_bus"
                app:tint="@color/md3_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Smartbus.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            android:text="@string/splash_title" />

        <TextView
            style="@style/TextAppearance.Smartbus.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="@string/splash_subtitle" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splashProgress"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:indeterminate="true"
            app:indicatorColor="@color/md3_primary"
            app:trackColor="@color/md3_primary_container"
            app:trackCornerRadius="999dp" />

        <TextView
            style="@style/TextAppearance.Smartbus.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/splash_loading" />
    </LinearLayout>

    <include layout="@layout/component_state_overlay" />

    <View
        android:id="@+id/snackbarAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/state_snackbar_anchor" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
