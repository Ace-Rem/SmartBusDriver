<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/md3_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                style="@style/TextAppearance.Smartbus.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_title" />

            <TextView
                style="@style/TextAppearance.Smartbus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:text="@string/profile_subtitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Smartbus.Card.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_primary_gradient"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <ImageView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:contentDescription="@string/profile_title"
                        android:padding="18dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/md3_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profileNameTextView"
                            style="@style/TextAppearance.Smartbus.Display"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_dash"
                            android:textColor="@color/md3_on_primary"
                            tools:text="Nguyễn Văn Minh" />

                        <TextView
                            android:id="@+id/profileRouteTextView"
                            style="@style/TextAppearance.Smartbus.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/placeholder_dash"
                            android:textColor="@color/md3_primary_container"
                            tools:text="BX01 - Bến xe Trung tâm" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Smartbus.Card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <TextView
                            style="@style/TextAppearance.Smartbus.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_trip_status" />

                        <TextView
                            android:id="@+id/profileRatingTextView"
                            style="@style/TextAppearance.Smartbus.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/placeholder_dash"
                            android:textColor="@color/smartbus_success"
                            tools:text="Đang chạy" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Smartbus.Card"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <TextView
                            style="@style/TextAppearance.Smartbus.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_passenger_metric" />

                        <TextView
                            android:id="@+id/profileShiftTextView"
                            style="@style/TextAppearance.Smartbus.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/placeholder_dash"
                            tools:text="24" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Smartbus.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/radius_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        style="@style/TextAppearance.Smartbus.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_license" />

                    <TextView
                        android:id="@+id/profileLicenseTextView"
                        style="@style/TextAppearance.Smartbus.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/placeholder_dash"
                        tools:text="B2 - 79A123456" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_sm"
                        android:background="@color/smartbus_divider" />

                    <TextView
                        style="@style/TextAppearance.Smartbus.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_phone" />

                    <TextView
                        android:id="@+id/profilePhoneTextView"
                        style="@style/TextAppearance.Smartbus.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/placeholder_dash"
                        tools:text="090 123 4567" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_sm"
                        android:background="@color/smartbus_divider" />

                    <TextView
                        style="@style/TextAppearance.Smartbus.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_current_stop" />

                    <TextView
                        android:id="@+id/profileVehicleTextView"
                        style="@style/TextAppearance.Smartbus.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/placeholder_dash"
                        tools:text="Công viên 23/9" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.Smartbus.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/profile_logout"
                app:icon="@drawable/ic_lock" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/profileProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/md3_primary"
                app:trackColor="@color/md3_primary_container" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/component_state_overlay" />

    <View
        android:id="@+id/snackbarAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/state_snackbar_anchor" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
